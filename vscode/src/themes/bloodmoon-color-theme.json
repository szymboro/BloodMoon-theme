  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6e6558", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"], "settings": { "foreground": "#c0483f" } },
    { "scope": ["keyword.operator", "punctuation"], "settings": { "foreground": "#a89880" } },
    { "scope": ["string", "string.quoted", "string.template"], "settings": { "foreground": "#9aaa6a" } },
    { "scope": ["string.regexp", "constant.character.escape"], "settings": { "foreground": "#d9a05a" } },
    { "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant"], "settings": { "foreground": "#d4785a" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#c9a45c" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#e0bf80" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#d8cbb0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#c8b090", "fontStyle": "italic" } },
    { "scope": ["variable.language", "variable.language.this"], "settings": { "foreground": "#c0483f", "fontStyle": "italic" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#c8b898" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#c0483f" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#c9a45c", "fontStyle": "italic" } },
    { "scope": ["support.type.property-name.css", "support.type.property-name.json"], "settings": { "foreground": "#c9a45c" } },
    { "scope": ["entity.name.namespace", "entity.name.module"], "settings": { "foreground": "#e0bf80" } },
    { "scope": ["meta.decorator", "entity.name.function.decorator"], "settings": { "foreground": "#d9a05a" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#c0483f", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#9aaa6a" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#c9a45c" } },
    { "scope": ["markup.inserted"], "settings": { "foreground": "#9aaa6a" } },
    { "scope": ["markup.deleted"], "settings": { "foreground": "#e05a4a" } },
    { "scope": ["invalid"], "settings": { "foreground": "#e05a4a" } }
  ]
}
